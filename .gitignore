.DS_Store
node_modules/

# Art assets are imported into the app on each device and synced through
# OneDrive. They must never be committed here.
assets-local/
*.zip

# Test output (tests/runall.sh). The test fixtures in tests/pack*/ are
# simple generated shapes, not art.
tests/out/
tests/*.png
tests/*.webp
tests/*.atlaspack
!tests/pack.zip
